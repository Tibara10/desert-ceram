---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, categories, type Category } from '../data/catalog';

const newProducts = products.filter((p) => p.isNew).slice(0, 4);
const cover: Record<Category, string> = { sol: 'tassili', mur: 'ghardaia', plinthe: 'plinthe-hoggar' };
const count = (c: Category) => products.filter((p) => p.category === c).length;

const figures = [
  { value: '18 000 m²', label: 'produits chaque jour', icon: 'M4 20h16M6 20V9l6-4 6 4v11M10 20v-6h4v6' },
  { value: '100 %', label: 'fabriqué en Algérie', icon: 'M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z' },
  { value: 'ISO 9001', label: 'et conformité EN 14411', icon: 'M9 12l2 2 4-4M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6z' },
  { value: '4', label: 'showrooms, 14 points de vente', icon: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z' },
];

const guide = [
  { k: 'PEI', title: 'Résistance à l’usure', text: 'De I à V : plus l’indice est élevé, plus l’émail supporte le passage. Un PEI IV convient à toute la maison, un PEI V aux commerces.' },
  { k: 'R9–R11', title: 'Glissance', text: 'Le classement R mesure l’adhérence. R9 pour les pièces sèches, R10 pour la cuisine, R11 et plus pour l’extérieur et les terrasses.' },
  { k: 'BIa / BIII', title: 'Absorption d’eau', text: 'Le grès cérame (BIa, ≤ 0,5 %) résiste au gel et à l’extérieur. La faïence (BIII) est réservée aux murs intérieurs.' },
];
---

<Base active="home">
  <!-- Hero -->
  <section class="hero">
    <img class="hero__bg" src="/img/hero-dunes.svg" alt="" width="1600" height="900" fetchpriority="high" />
    <div class="container hero__content">
      <p class="eyebrow eyebrow--light">Carrelage & faïence · depuis le Sud algérien</p>
      <h1>La céramique qui garde la lumière du désert</h1>
      <p class="hero__lead">
        Des sols et des murs aux teintes de sable, d'ocre et de terre cuite, pensés pour la maison comme pour les projets
        professionnels.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--light" href="/collections/">Découvrir les collections</a>
        <a class="btn btn--outline-light" href="/devis/">Demander un devis</a>
      </div>
    </div>
  </section>

  <!-- Chiffres clés -->
  <section class="figures" aria-label="Chiffres clés">
    <div class="container figures__grid">
      {figures.map((f) => (
        <div class="figure">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={f.icon} /></svg>
          <p class="figure__value">{f.value}</p>
          <p class="figure__label">{f.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Univers -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Nos univers</p>
        <h2>Du sol au mur, une même palette</h2>
      </div>
      <div class="universes">
        {(Object.keys(categories) as Category[]).map((c) => (
          <a class="universe" href={`/collections/?cat=${c}`}>
            <img src={`/tiles/${cover[c]}.svg`} alt="" width="600" height="600" loading="lazy" />
            <div class="universe__body">
              <h3>{categories[c].label}</h3>
              <p>{categories[c].text}</p>
              <span class="universe__more">{count(c)} références →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Nouveautés -->
  <section class="section section--sand">
    <div class="container">
      <div class="section__head section__head--row">
        <div>
          <p class="eyebrow">Nouveautés</p>
          <h2>Les dernières sorties d’usine</h2>
        </div>
        <a class="link-arrow" href="/collections/">Tout le catalogue →</a>
      </div>
      <div class="products">
        {newProducts.map((p) => <ProductCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- À propos -->
  <section class="section" id="a-propos">
    <div class="container about">
      <img class="about__img" src="/img/about-arches.svg" alt="" width="900" height="700" loading="lazy" />
      <div>
        <p class="eyebrow">L’entreprise</p>
        <h2>Fabriquer ici, avec les matières d’ici</h2>
        <p>
          Desert Ceram transforme des argiles et des sables sélectionnés en carreaux de grès cérame et en faïences
          émaillées. Nos décors puisent dans les paysages du Sud : la courbe des dunes, la pierre du Hoggar, la
          géométrie des zelliges et la terre des ksour.
        </p>
        <ul class="ticks">
          <li>Contrôle qualité à chaque étape, de la presse au four</li>
          <li>Fiches techniques complètes pour chaque référence</li>
          <li>Accompagnement des architectes et des poseurs</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Guide -->
  <section class="section section--dark">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow eyebrow--light">Guide</p>
        <h2>Lire une fiche technique en trente secondes</h2>
      </div>
      <div class="guide">
        {guide.map((g) => (
          <div class="guide__item">
            <p class="guide__k">{g.k}</p>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container cta">
      <div>
        <h2>Un projet de construction ou de rénovation ?</h2>
        <p>Estimez la quantité nécessaire et recevez une proposition adaptée à votre surface.</p>
      </div>
      <div class="cta__btns">
        <a class="btn" href="/devis/">Demander un devis</a>
        <a class="btn btn--ghost" href="/distributeurs/">Trouver un distributeur</a>
      </div>
    </div>
  </section>
</Base>
